# TrialVigil local-mode environment — copy to infra/.env and edit.
# All values have safe defaults in docker-compose.yml / run-local.sh.

# --- Ports ---
CONSOLE_PORT=3000
HARNESS_PORT=3001

# --- Data ---
# Host directory for the local JSON store + audit log (run-local.sh only).
# In docker compose the named volume `trialvigil-data` is used instead.
DATA_DIR=./data

# --- Local LLM (optional) ---
# Ollama is optional; the demo works without it (deterministic extractor).
# In docker compose, the harness reaches Ollama at http://ollama:11434.
# For run-local.sh (host processes), use http://localhost:11434.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
