# TrialVigil local-mode environment — copy to infra/.env and edit.
# All values have safe defaults in docker-compose.yml / run-local.sh.

# --- Ports ---
CONSOLE_PORT=3000
HARNESS_PORT=3001

# --- Data ---
# Host directory for the local JSON store + audit log (run-local.sh only).
# In docker compose the named volume `trialvigil-data` is used instead.
DATA_DIR=./data

# --- OpenWorker SDK (optional) ---
# The SDK path is opt-in: OPENWORKER_ENABLED=1 plus a provider key and model.
# OpenAI (default): OPENWORKER_API=responses, OPENWORKER_MODEL_URL=https://api.openai.com/v1,
#   OPENAI_API_KEY=<key>, OPENWORKER_MODEL=<openai model id>.
# NVIDIA NIM free tier: OPENWORKER_API=chat-completions,
#   OPENWORKER_MODEL_URL=https://integrate.api.nvidia.com/v1,
#   NVIDIA_API_KEY=<nvapi- key from build.nvidia.com>, OPENWORKER_MODEL=mistralai/mistral-large-4-1t-a52b.
# Free tier is ~40 req/min, prototyping only, synthetic data only. Never commit keys.
# OPENWORKER_ENABLED=0
# OPENWORKER_API=chat-completions
# OPENWORKER_MODEL_URL=https://integrate.api.nvidia.com/v1
# OPENWORKER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Local LLM (optional) ---
# Ollama is optional; the demo works without it (deterministic extractor).
# In docker compose, the harness reaches Ollama at http://ollama:11434.
# For run-local.sh (host processes), use http://localhost:11434.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
