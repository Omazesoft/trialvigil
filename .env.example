# Port / host for the harness service (default 3001)
PORT=3001
HOST=127.0.0.1

# --- Optional: OpenWorker SDK path (OFF by default) ---
# The demo works with NO LLM and NO keys, using the local loop in
# packages/harness-adapter. Only set these to try the real SDK loop.
# OPENWORKER_ENABLED=1
# OPENAI_API_KEY=
# OPENWORKER_MODEL=
# OPENWORKER_MODEL_URL=https://api.openai.com/v1

# --- Optional: Ollama path (OFF by default) ---
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
